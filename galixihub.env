# galixihub.env

# All INITIAL configuration settings are set here. Please note that
# once a world is configured, the below IS NO LONGER USED by galixihub
# and its values cannot change, even if the below is changed. If a 
# different world name, for example, is desired a new world must be 
# created. All other world settings (such as world icon/image) can be 
# changed via a device running GalixiCom (the client) set in Owner or 
# Administrator configuration. 

# License for the Docker image for galixihub is at:
#   https://galixsys-networks.com/hub-terms-and-conditions/
# Set to YES to accept by Docker image license.  
# Once set to YES, it cannot be changed here; any change here will have 
# no effect.
GALIXIHUB_ACCEPT_LICENSE=NO

# Name of the world. Cannot be changed once set
GALIXIHUB_WORLD_NAME="Test World"

# Host name of the world. Cannot be changed once set.
# It is STRONGLY RECOMMENDED to use a domain name here
GALIXIHUB_HOSTNAME=localhost

# Base network port used for the world. Cannot be changed once set.
# Any firewall, etc., must have this number and the next 
# (so GALIXIHUB_PORT + 1) opened for external devices to connect.
GALIXIHUB_PORT=50500

# Initial owner code. After the world creator connects with their
# device, they should change this code with their device.
GALIXIHUB_OWNER_CODE=123456

# LAN IP of the Docker host machine (e.g. 192.168.1.100).
# In Docker, auto-detection returns the container's internal bridge IP
# (172.x.x.x) which is unreachable from client devices on the LAN.
# Set this to the host's actual LAN IP so that same-LAN clients can
# connect directly without going through the public hostname and NAT.
# Leave commented out or empty if all clients always connect via GALIXIHUB_HOSTNAME.
#GALIXIHUB_LOCAL_IP=192.168.1.100
